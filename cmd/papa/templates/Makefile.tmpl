# Windows 下 go build -o 不会自动加 .exe，按操作系统补齐后缀
ifeq ($(OS),Windows_NT)
	EXE := .exe
else
	EXE :=
endif

.PHONY: build run migrate test race vet clean docker-up docker-down

build:
	go build -o bin/crawler$(EXE) .

run:
	go run .

# 建 / 补表（框架自带的表 + 本项目 models 里注册的模型）。只增不减、可重复跑；
# 新开 server.operation_log / crawler.trace.enabled 之后也要重跑一次。
migrate:
	go run . -migrate

test:
	go test ./...

# 竞态检测：需要 C 编译器（Windows 上装 MinGW gcc）；从 Git Bash 跑 make 即可
race:
	CGO_ENABLED=1 go test -race ./...

vet:
	go vet ./...

clean:
	rm -rf bin/ logs/*.log downloads/*

docker-up:
	docker compose -f docker/docker-compose.yml up -d

docker-down:
	docker compose -f docker/docker-compose.yml down
