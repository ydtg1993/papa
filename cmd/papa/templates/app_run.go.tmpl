package app

import (
	"context"
	"flag"
	"fmt"
 "os"
 ep "github.com/ydtg1993/papa/v4/pkg/executionpolicy"
	"os/signal"
	"syscall"

	"github.com/ydtg1993/papa/v4"
	"{{.Module}}/internal/monitor"
 "{{.Module}}/internal/models"
	// 匿名导入：让 sites 里各站点文件的 init() 跑起来（它们自己登记到框架）。
	// 加一个站 = 加一个文件，这里和 main 都不用改。
	_ "{{.Module}}/internal/sites"
)

func Run(args []string) {
	// 1. 创建应用容器。配置路径用 `--config` 指定：
	//      go run . --config=./config.yaml
	//    缺省依次读 PAPA_CONFIG 环境变量、configs/config.yaml。
	//    注册模型也可以走这里（papa.WithModels(...)），不过脚手架统一在internal/models 包里登记。
	flags := flag.NewFlagSet("{{.Module}}", flag.ExitOnError)
	var (
		configPath = flags.String("config", "", "配置文件路径（默认 configs/config.yaml，也可用 PAPA_CONFIG）")
		doMigrate  = flags.Bool("migrate", false, "建表后退出（papa migrate 会转交到这里）")
		autostart  = flags.Bool("autostart", false, "启动时自动开放全部站点采集；默认暂停，等待 OA 恢复整站")
	)
	policyInit := flags.String("init-policy", "", "显式初始化执行策略 JSON 后退出，不覆盖已有策略")
 migratePolicy:=flags.String("migrate-breaker-policy", "", "离线迁移旧熔断快照，输入升级前有效策略 JSON")
 confirmedRevision:=flags.Uint64("confirmed-policy-revision", 0, "确认旧熔断策略版本，迁移时必须大于零")
 flags.Parse(args)

	var opts []papa.Option
	if *configPath != "" {
		opts = append(opts, papa.WithConfigPath(*configPath))
	}
	app, err := papa.New(opts...)
	if err != nil {
		panic(fmt.Sprintf("init app failed: %s", err.Error()))
	}

	// 1.1 建表：`go run . -migrate`（Makefile 里是 `make migrate`；在项目目录里跑
	//     `papa migrate` 也会转交到这里）。
	//     框架自带的表（按配置开关）+ internal/models 包里登记的模型一起建；
	//     AutoMigrate 只增不减、可重复跑，所以本地和上线前都可以随便跑。
	//     启动时**不会**自动迁移 —— 新开的开关（server.operation_log）
	//     也要重跑一次才会建出对应的表。迁移分支独立登记模型，不初始化后台。
	if *doMigrate {
		app.UseModels(models.Models()...)
		if err := app.Migrate(); err != nil {
			panic(fmt.Sprintf("migrate failed: %s", err.Error()))
		}
		fmt.Println("表已就绪。")
		return
	}

	monitor.Register(app)

	// 2. 可选：设置代理（需在 RegisterSites 之前）。
	//    **下载器不在这里配**：框架已按 DefaultConfig 备好基座，要按站点/阶段各配一份就写在
	//    internal/sites/<站名>.go 的 SiteSpec.FileDown / M3U8 上（解析顺序：阶段 > 站点）。
	// app.Engine.SetProxy(proxy.NewManagerWithNetwork(app.Config.Proxy.APIURL, 8*time.Minute, app.Config.Network))

	// 3. 注册站点与阶段：站点在 internal/sites/ 下一站一个文件（自己登记），框架把它们收在
	//    papa.Sites() 里 —— 加一个站只加文件，main 不用动。并发/队列/间隔/重试/要不要投入口/
	//    起始任务由 fetcher 自己的 SubmitEntries 提交；熔断参数仅从数据库读取。
	// 注册前统一设置启动闸门，入口与恢复任务都受约束；站点文件无需逐个配置 StartPaused。
	sites := papa.Sites()
	for i := range sites {
		sites[i].StartPaused = !*autostart
	}
	app.RegisterSites(sites...)
 if *migratePolicy!="" {raw,err:=os.ReadFile(*migratePolicy);if err!=nil{panic(err)};d,err:=ep.Decode(raw);if err!=nil{panic(err)};if err=app.MigrateExecutionPolicySnapshots(context.Background(),*confirmedRevision,d);err!=nil{panic(err)};fmt.Println("熔断策略快照迁移完成。");return}
 if *policyInit != "" { raw,err:=os.ReadFile(*policyInit); if err!=nil{panic(err)};d,err:=ep.Decode(raw);if err!=nil{panic(err)};if err=app.InitializeExecutionPolicy(context.Background(),d,"local-cli");err!=nil{panic(err)};fmt.Println("执行策略已初始化。");return }

	if *autostart {
		fmt.Println("采集启动模式：自动开启全部站点（--autostart），仍受熔断与运行策略约束。")
	} else {
		fmt.Println("采集启动模式：全部站点暂停；完成准备后在 OA 恢复整站。")
	}

	// 4. 优雅关闭
	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	app.Run(ctx)
}
