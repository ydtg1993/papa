# 应用基础配置
app:
  env: dev                     # 运行环境：dev / prod。只影响 SQL 日志详略，建表一律走 `papa migrate`

# 爬虫核心配置
crawler:
  dedup_cache_size: 10000      # 内存去重表上限：0=不限；>0 用 LRU 限界，淘汰条目由 DB 唯一索引兜底
  queue_watermark: 0.75        # 队列高水位(0-1)：达到后新任务溢出到 DB 待回灌，避免满队列丢任务
  drain_interval: "2s"         # 溢出任务回灌队列的间隔
  stop_timeout: "5s"           # 优雅退出时等各阶段 worker 排空队列的上限；超时则跳过关库/关浏览器池，让在途写入落盘
  stage_idle_timeout: "0s"     # 阶段工作池连续空闲多久就回收（0=常驻不回收）；多站/长跑建议配，如 "10m"
  # 单任务步骤追踪：task.Trace.Step/Fail/Warn（关 = 安全的 no-op）。开启后要再跑一次 `papa migrate` 建表。详见 docs/CORE_CONFIG.md
  trace:
    enabled: true              # 是否开启步骤追踪
    retention: "168h"          # 步骤记录保留期（默认 7 天）；负数 = 不自动清理
  # 页面归档：**失败那一刻抓到的那一页**按原始字节落盘（不重新序列化，否则丢 <noscript> 回退标签）；
  # 本次尝试结束自动写、handler 不用写代码，trace 里多一条「归档页面」步骤指向 {dir}/{site}/{stage}/task-{id}-try-{retry}-{urlhash8}.html。
  archive:
    enabled: false             # 默认关。排查选择器/登录墙/地区限制时打开
    dir: "./logs/fetcher-html" # 归档根目录（enabled=true 时必填，没写会启动 panic）
    mode: failure              # failure = 只在失败的尝试落（默认，写入量按失败率走）；always = 每次都落
    retention: "168h"          # 保留期（默认 7 天，与 trace 对齐）；负数 = 不自动清理
    max_file_mb: 8             # 单页上限（MB）；超了不归档并记 WARN
  # 熔断闸门：窗口内**终态失败**数（重试耗尽或不可重试，不是每次 attempt）达阈值就把该站所有阶段的 worker 闸住，
  # 并发一条 critical 告警；从后台右上角铃铛面板的「恢复」放行（可逐站放行）。暂停**不跨重启**。
  # **闸门每站一把**：这里这份是**没单配阈值的站点**用的默认值（`SiteSpec.Breaker` 按站点覆盖），
  # 一个站被墙不会把别的站一起闸住。详见 docs/CORE_CONFIG.md
  breaker:
    enabled: true              # 是否启用（默认 false）
    window: "5m"               # 统计窗口
    threshold: 50              # 达阈值即暂停。enabled=true 时必填且必须 > 0（没写会启动 panic）
  # 阶段参数不在这里配：声明在 sites/<站名>.go（Go 里一份写全）。详见 docs/FETCHER_WRITING_GUIDE.md 7.2

# 浏览器自动化池：按需创建，pool_size / direct_pool_size 是并发上限（走池 / 直连两类实例），不是常驻实例数，
# 空闲超过 max_idle_time 的会被回收。
# 全部字段都是**改完重启才生效**（框架没有运行期热更这回事）。
browser:
  enable: true
  pool_size: 3                 # 并发上限（按需创建）。enable=true 时必填且 > 0：写 0 会让 Get 永久阻塞在 cond.Wait
  direct_pool_size: 0          # 强制直连浏览器并发上限；0 = 不用直连池（合法，调到时会明确报错）
  max_idle_time: "5m"
  headless: false
  no_sandbox: false
  # leakless 默认关，**别开**：rod 的 leakless 辅助程序会被 Windows Defender 直接拦掉
  #（实测报 "contains a virus or potentially unwanted software"）。要写就写 leakless: false。
  binary: rod                  # rod=Rod 自动下载并管理（服务器不用手装）；system=系统已安装的；path=用 browser_path
  browser_path: ""             # 仅 binary: path（或 binary 留空）时生效；binary: rod/system 时写它会被拒绝
  self_check: false            # true = 启动时真实启动一次浏览器（rod 模式会触发下载），起不来就启动失败
  flags: {}                    # 额外 Chromium 开关；键=开关名，值为空 = 布尔开关；数字要加引号，如 {disable-gpu: "", renderer-process-limit: "2"}
  # 请求头写站点声明（sites/<站名>.go 的 Headers，抓取与下载都认）；这里是**全局默认层**，
  # 只放与站点无关的头（多站共用的那一层）：headers: {Accept-Language: "zh-CN,zh;q=0.9"}

# 静态 HTML 抓取客户端。timeout / max_body_size / headers 都是全局默认，同样改完重启生效。
html:
  enable: true
  timeout: "15s"
  max_body_size: 10485760      # enable=true 时必填，100KB..64MB
  # 请求头同上（写站点声明）。不写的话静态抓取的 UA 是框架默认的 PapaStaticHTML/1.0 —— 真实站点多半会拦。

# 代理管理器（未启用）
proxy:
  api_url: ""
  refresh_interval: 500s

# 数据库
db:
  driver: "mysql"
  dsn: "root:123456@tcp(127.0.0.1:3306)/crawler?charset=utf8mb4&parseTime=True&loc=Local"
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime: 1h
  conn_max_idle_time: 10m
  # SQL 日志级别：silent / error / warn / info；留空按 app.env 推（dev=info，其它=warn 且隐去参数值）。
  # log_level: "info"

# 日志
log:
  dir: "./logs"
  max_size: 10
  max_days: 7
  max_backups: 30
  compress: true
  local_time: true

# 运行观测（框架通用事件流；默认关）
obs:
  events:
    enabled: false               # 打开后写 logs/events.jsonl（一行一个 JSON 事件）；本地排查/出报告时开
    file: "events.jsonl"
    buffer: 8192                 # 异步队列；满则丢弃并计数，绝不阻塞 worker
    snapshot_interval: "30s"     # 阶段/队列周期快照事件间隔；"0" = 不发
  report:                        # 报告引擎在后续版本实现（当前仅占位）
    on_exit: false
    dir: "./reports"

# 统一 HTTP 服务（监控后台）
server:
  enabled: true                  # 开则挂载 /monitor + /api/* + 表格页 + 自定义页；关则完全不监听
  port: 9090
  # 访问令牌在 crawler_access_token 表（一条令牌一个操作人）：papa token add --operator <名字>，
  # 明文只打印一次、库里只存 sha256；一条都没有时 /api/* 对白名单内来源完全开放（启动会警告）。
  # 令牌数量有 1 分钟进程内 TTL 缓存：后台令牌页的写操作即时生效；papa token add（另一进程）最迟约 1 分钟可见。
  # 来源 IP/CIDR 白名单**不在配置里**了：它存在 crawler_config 表的 ip_whitelist 行
  # （运行期在后台「设置」页改，改完立刻生效；本进程读有 5 分钟 TTL 缓存，跨实例/直接改 SQL 最迟约 5 分钟可见）。空 / 读不到 = 不限制来源，只靠访问令牌那道门。
  monitor_dirs:                   # 监控页展示的业务目录占用（name: path）
    downloads: "./downloads"
    logs: "./logs"
  queue_sample_interval: "1m"     # 队列积压采样间隔；监控页读内存快照，采样时才查库，调大可降 DB 压力
  operation_log: true             # 后台增删改写 crawler_operation_log（含失败），并多出「操作日志」页
  read_header_timeout: "10s"      # 挡慢连接（只发头不发送体）
  read_timeout: "30s"
  idle_timeout: "60s"
  shutdown_timeout: "10s"         # 优雅退出时等在途请求（如日志打包下载）的上限
  # write_timeout 默认 0 = 不限，这是有意的：给日志打包下载设上限等于掐断在途下载。

# 三个治理队列（全局各一条，不再按站点拆）。没写哪一段 = 那条不跑；开了（enabled: true）就得写全，
# 缺一项 / 值越界启动就报。详见 docs/CORE_CONFIG.md 的对应三节。
error_queue:
  enabled: true               # 失败任务重投；interval="0" = 不自动轮询，只留后台手动触发
  worker_count: 1             # 并发重新投递数，必须 > 0
  interval: "4h"              # 自动轮询间隔
  max_retry: 3                # 单条失败任务最多再处理几代；0 = 不限
  batch_size: 100             # 每批处理条数；0 = 默认 1000（分页流式，不能为负）
recover_queue:
  enabled: true               # 启动恢复：重启时捡回上次中断留下的「未到终态」任务（只在启动跑一次）
  worker_count: 1
  batch_size: 100             # 每批处理条数；0 = 默认 1000（分页流式）
  batch_pause: "30m"          # 批间停顿（默认 30m）：每批投完先让 worker 消化，再继续下一批；要连续跑完写 1ms
repeat_queue:
  enabled: true               # 周期轮询：把「到点的」repeatable 任务重投回各自阶段
  worker_count: 1
  interval: "2h"              # 最粗兜底的扫描间隔，必须 > 0
  batch_size: 100

# 业务自己的配置写在这里：框架**不解析、不校验**这一段，原样透出给 App
#（`app.Config.BusinessSection("covers", &covers)` 解码；详见 docs/CORE_CONFIG.md 的 business 段）。
# business:
#   covers:
#     dir: ./covers
