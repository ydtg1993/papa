# 应用基础配置
app:
  env: dev                     # 运行环境：dev / prod。只影响 SQL 日志详略，建表一律走 `papa migrate`
  # dev 的 SQL 日志可能包含敏感参数；使用真实数据时应限制日志访问，按需改用 prod。

# 爬虫核心配置
crawler:
  dedup_cache_size: 10000      # 内存去重表上限：0=不限；>0 用 LRU 限界，淘汰条目由 DB 唯一索引兜底
  stop_timeout: "5s"           # worker/ticker 共用排空预算；超时保留DB，最终另用此预算强制清理浏览器池
  stage_idle_timeout: "0s"     # 阶段工作池连续空闲多久就回收（0=常驻不回收）；多站/长跑建议配，如 "10m"
  # 步骤与原始 HTML/JSON 快照：默认仅保留异常尝试到同一 Trace 文件，不需要迁移。详见 docs/framework/configuration/CORE_CONFIG.md
  trace:
    mode: errors              # off=关闭；errors=异常（默认）；all=全部尝试
    retention: "168h"          # 步骤与快照保留期（默认 7 天）；负数 = 不自动清理
  trace_files:
    dir: "./traces"           # 专用目录；容量满时拒绝新证据并告警，不影响任务结算
    max_file_bytes: 4194304   # 整个记录上限；超限丢弃快照并标记截断，保留步骤
    max_total_bytes: 268435456
    max_files: 10000
  # 熔断闸门：窗口内**终态失败**数（重试耗尽或不可重试，不是每次 attempt）达阈值就把该站所有阶段的 worker 闸住，
  # 并发一条 critical 告警；自动保护状态持久化，按冷却/试探预算恢复，人工暂停不自动解除。
  # **闸门每站一把**：这里这份是**没单配阈值的站点**用的默认值（`SiteSpec.Breaker` 按站点覆盖），
  # 一个站被墙不会把别的站一起闸住。详见 docs/framework/configuration/CORE_CONFIG.md
  # 阶段结构/物理容量声明在 internal/sites/<站名>.go；有效并发与间隔可由 runtime/OA 覆盖。

# 浏览器启动配置；池容量与空闲时间在 OA 数据库策略中调整。
browser:
  enable: true
  headless: false
  no_sandbox: false
  # leakless 默认关，**别开**：rod 的 leakless 辅助程序会被 Windows Defender 直接拦掉
  #（实测报 "contains a virus or potentially unwanted software"）。要写就写 leakless: false。
  binary: rod                  # rod=Rod 自动下载并管理（服务器不用手装）；system=系统已安装的；path=用 browser_path
  temp_dir: ""                 # 临时目录根路径；Linux 可设 /dev/shm/crawler，空值使用系统临时目录；重启生效
  browser_path: ""             # 仅 binary: path（或 binary 留空）时生效；binary: rod/system 时写它会被拒绝
  self_check: false            # true = 启动时真实启动一次浏览器（rod 模式会触发下载），起不来就启动失败
  flags: {}                    # 额外 Chromium 开关；键=开关名，值为空 = 布尔开关；数字要加引号，如 {disable-gpu: "", renderer-process-limit: "2"}
  # 请求头写站点声明（internal/sites/<站名>.go 的 Headers，抓取与下载都认）；这里是**全局默认层**，
  # 只放与站点无关的头（多站共用的那一层）：headers: {Accept-Language: "zh-CN,zh;q=0.9"}

# 静态 HTML 抓取客户端。timeout / max_body_size / headers 都是全局默认，同样改完重启生效。
html:
  enable: true
  timeout: "15s"
  max_body_size: 10485760      # enable=true 时必填，100KB..64MB
  # 请求头同上（写站点声明）。不写的话静态抓取的 UA 是框架默认的 PapaStaticHTML/1.0 —— 真实站点多半会拦。

# 代理管理器（未启用）
proxy:
  api_url: ""
  refresh_interval: 500s

# 运行治理默认关闭；OA 持久覆盖优先于本段显式字段。详见 docs/framework/runtime/RUNTIME_CONTROL.md。
# 升级后先 papa migrate；文件时长写 "30s"，API JSON 时长为整数纳秒。
# 账号健康/额度按账号由 OA 管理，不在此重复配置；默认不逐次计量、不自动恢复登录。
# OA 新增账号需要业务注册 Provider 与加密存储，见 docs/framework/accounts/ACCOUNT_ONBOARDING.md。
runtime:
  defaults:
    request:
      enabled: false
      autothrottle:
        enabled: false
  sites: {}
  resources:
    enabled: false
  proxy_health:
    enabled: false

# 数据库
db:
  driver: "mysql"
  dsn: "user:CHANGE_ME@tcp(127.0.0.1:3306)/crawler?charset=utf8mb4&parseTime=True&loc=Local"
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime: 1h
  conn_max_idle_time: 10m
  # SQL 日志级别：silent / error / warn / info；留空按 app.env 推（dev=info，其它=warn 且隐去参数值）。
  # log_level: "info"

# 可选动态阶段调度：启用后 papa migrate；普通任务默认不纳入调度。
# 运行中策略经具名后台人工确认后生效；不会自动创建采集或发布。
task_flow:
  enabled: false

# 日志
log:
  dir: "./logs"
  level: "info"                  # debug / info / warn(warning) / error；默认 info
  max_size: 10
  max_days: 7
  max_backups: 30
  compress: true
  local_time: true

# 运行观测（框架通用事件流 + 运行报告；默认关）。详见 docs/framework/operations/OBSERVABILITY.md
obs:
  events:
    enabled: false               # 开启在线信号报告与 logs/events.jsonl 归档；默认关闭
    file: "events.jsonl"
    buffer: 8192                 # 异步队列；满则丢弃并计数，绝不阻塞 worker
    snapshot_interval: "30s"     # 阶段/队列周期快照事件间隔；"0" = 不发
  report:
    on_exit: false               # 尽力生成退出信号快照；与事件归档合计最多等 2 秒
    interval: "0"                # 定时生成报告：如 "30m" = 每 30 分钟刷新当天日报；0/不写 = 关（与 on_exit 独立，可只开定时）
    # mode: auto              # 仅离线分析：auto（默认）= snapshot；验收选 acceptance；
                              # 在线固定 snapshot，不执行验收或查库
    dir: "./reports"             # 产物目录：<dir>/<2006-01-02>/（report.md / report.json / ai-brief.md / ai-brief.json）；后台「obs报告」页也读它
    retention: "168h"            # 报告保留期；默认 7 天；负数 = 永久保留（每次生成报告后清过期目录）
    timeout: "120s"              # 离线分析的协作超时；在线退出不使用此值扩展 2 秒总预算
    thresholds:                  # 离线通用分析节（framework）的阈值
      stuck_after: "10m"
      event_max_gap: "10m"      # 事件相邻间隔超过它 → event_coverage 告警（丢事件/被硬杀）
      crawl_fail_rate_max: 0.05

# 统一 HTTP 服务（监控后台）
server:
  enabled: true                  # 开则挂载 /monitor + /api/* + 表格页 + 自定义页；关则完全不监听
  port: 9090
  # 访问令牌在 crawler_access_token 表（一条令牌一个操作人）：papa token add --operator <名字>，
  # 明文只打印一次、库里只存 sha256；管理接口始终要求有效令牌，空表也拒绝访问。
  # 令牌数量有 1 分钟进程内 TTL 缓存：后台令牌页的写操作即时生效；papa token add（另一进程）最迟约 1 分钟可见。
  # 来源 IP/CIDR 白名单**不在配置里**了：它存在 crawler_config 表的 ip_whitelist 行
  # （运行期在后台「设置」页改，改完立刻生效；本进程读有 5 分钟 TTL 缓存，跨实例/直接改 SQL 最迟约 5 分钟可见）。空 / 读不到 = 不限制来源，只靠访问令牌那道门。
  monitor_dirs:                   # 监控页展示的业务目录占用（name: path）
    downloads: "./downloads"
    logs: "./logs"
  queue_sample_interval: "1m"     # 队列积压采样间隔；监控页读内存快照，采样时才查库，调大可降 DB 压力
  operation_log: true             # 后台增删改写 crawler_operation_log（含失败），并多出「操作日志」页
  read_header_timeout: "10s"      # 挡慢连接（只发头不发送体）
  read_timeout: "30s"
  idle_timeout: "60s"
  shutdown_timeout: "10s"         # 优雅退出时等在途请求（如日志打包下载）的上限
  # write_timeout 默认 0 = 不限，这是有意的：给日志打包下载设上限等于掐断在途下载。

# 三条全局治理队列始终运行；详见 docs/framework/configuration/CORE_CONFIG.md。
error_queue:
  worker_count: 1
  interval: "4h"              # 0 / 不写 = 4h
  max_retry: 3                # 单条任务自动重试次数上限；0 = 不限
  batch_size: 100             # 0 = 默认 1000
recover_queue:
  batch_size: 100             # 持续按阶段空位恢复 pending，0 = 默认 1000
repeat_queue:
  worker_count: 1
  interval: "12h"             # 0 / 不写 = 12h；只重投成功任务
  batch_size: 100

# 业务自己的配置写在这里：框架**不解析、不校验**这一段，原样透出给 App
#（`app.Config.BusinessSection("covers", &covers)` 解码；详见 docs/framework/configuration/CORE_CONFIG.md 的 business 段）。
# business:
#   covers:
#     dir: ./covers

# 采集出口默认只允许公网 HTTP(S)；内网按完整 origin 授权，重启生效。
network:
  private_origins: []
  allowed_origins: []          # 非空时只允许列出的精确 origin；不代替 private_origins 的内网授权
