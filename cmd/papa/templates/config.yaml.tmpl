# 应用基础配置
app:
  env: dev                     # 运行环境：dev(开发,自动迁移) / prod(生产)

# 爬虫核心配置
crawler:
  target: ""                   # 起始目标网站（main.go 里拼起始 URL 用）
  dedup_cache_size: 0          # 内存去重表最大条目数：0=不限(旧行为)；>0 用 LRU 限界，淘汰条目由 DB 唯一索引兜底
  queue_watermark: 0.75        # 队列高水位比例(0-1)：达到后新任务溢出到 DB 待回灌，避免满队列丢任务
  drain_interval: "2s"         # 溢出任务回灌队列的间隔
  stages:                      # 爬取阶段配置
    catalog:                   # 阶段名需与 fetcher.GetStage() 返回一致
      worker_count: 1
      queue_size: 20
      delay: "5m"              # 任务间隔延迟：固定 "5m" 或随机区间 "10s-30s"
      retry:
        max_attempts: 3
        backoff: "30s"

# 浏览器自动化池配置
# 运行期热更（OA 后台 /api/config 可改，重启后叠加 runtime.yaml 覆盖层）：
#   pool_size / direct_pool_size / max_idle_time / headers
# 其余字段（headless / no_sandbox / leakless / browser_path / enable）需重启生效。
browser:
  enable: true
  pool_size: 3
  direct_pool_size: 0
  max_idle_time: "5m"
  headless: false
  no_sandbox: false
  browser_path: ""             # Chrome 可执行文件路径，空则用默认 Chromium
  headers:
    User-Agent: "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    Accept: "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8"
    Accept-Language: "zh-CN,zh;q=0.9,en;q=0.8"

# 静态 HTML 抓取客户端配置
# 运行期热更：timeout / max_body_size / headers
html:
  enable: true
  timeout: "15s"
  max_body_size: 10485760
  headers:
    User-Agent: "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    Accept: "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8"
    Accept-Language: "zh-CN,zh;q=0.9,en;q=0.8"

# 代理管理器配置（未启用）
proxy:
  api_url: ""
  refresh_interval: 500s

# 数据库配置
db:
  driver: "mysql"
  dsn: "root:123456@tcp(127.0.0.1:3306)/crawler?charset=utf8mb4&parseTime=True&loc=Local"
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime: 1h
  conn_max_idle_time: 10m

# 日志配置
log:
  dir: "./logs"
  max_size: 10
  max_days: 7
  max_backups: 30
  compress: true
  local_time: true

# 统一 HTTP 服务配置（监控页面）
server:
  enabled: true
  port: 9090
  monitor: true
  auth_key: ""                    # 内联密钥（优先级低于 auth_key_file）；两者都空则不校验
  auth_key_file: "configs/secret" # 密钥文件路径，papa new 已自动生成 configs/secret
  whitelist: []                   # 回退白名单（仅当 whitelist_file 不存在时生效）
  whitelist_file: "configs/whitelist" # 白名单持久化文件（设置页动态改白名单会写回此文件）
  monitor_dirs:                   # 监控页展示的业务目录占用（name: path）
    downloads: "./downloads"
    logs: "./logs"

# 定时任务调度器配置
# 定时任务调度器：业务定时任务通过 app.RegisterCronJob 注册（框架不再内置 job）
scheduler:
  timezone: "Asia/Shanghai"   # cron 时区

# 错误队列处理（失败任务自动/手动重新投递）
error_queue:
  enabled: false          # 是否启用错误队列处理
  worker_count: 2         # 并发重新投递失败任务的数量
  interval: "10m"         # 自动轮询间隔；0 = 不自动轮询，仅 OA 后台手动触发
  max_retry: 3            # 单个失败任务最多再处理代数；0 = 不限

# 中断恢复队列（主程序重启后立即恢复卡死的 pending/processing 任务，也可定时/手动触发）
recover_queue:
  enabled: true           # 是否启用；启用后启动时立即恢复一次
  worker_count: 2         # 并发恢复数量
  interval: "10m"         # 自动轮询间隔；0 = 仅启动时 + OA 后台手动触发
  timeout: "6h"           # 任务卡住多久算卡死（updated_at 早于 now-timeout）
