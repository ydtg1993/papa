package fetcher

import (
	"context"
	"strings"
	"time"

	"github.com/ydtg1993/papa/v3"
)

// FetchCatalog 阶段一：抓取目录/列表页。
// 职责：打开目标页 → 提取标题 + 详情链接 → 派发 detail 子任务。
type FetchCatalog struct{}

// GetStage 返回阶段名；它在整个程序里必须唯一（多站就带站点前缀，如 hgd_catalog）。
// 重名会在启动时报错并点出来。
func (f *FetchCatalog) GetStage() string { return "catalog" }

// SubmitEntries 入口任务：本阶段"注册即投一批起始任务"。实现这个方法就够了 ——
// 框架在启动时自动调它（那时**所有**阶段的池子都已建好，所以这里能往任意阶段投）。
// 不需要起始任务就删掉这个方法（阶段照常跑，只是没人往里投任务）。
//
// site 是本站声明（configs/sites/{{.Module}}.go）的快照：BaseURL / Headers 都在里面 ——
// 入口路由（"要抓哪些分类"）是本站业务逻辑，就写在这个文件里，不放站点声明。
func (f *FetchCatalog) SubmitEntries(engine *papa.Engine, site papa.Site) {
	if err := engine.SubmitTask(&papa.Task{
		PID: 0,
		// 起始 URL：根地址取自站点声明。任务里放什么都行（列表页、详情页、API 地址……）；
		// 分类多于一个时，在本文件顶部声明一张包级路由表（`var catalogRoutes = []struct{...}`），
		// 在这里遍历它 —— 写法见 docs/FETCHER_WRITING_GUIDE.md「如何驱动任务」的初始任务示例。
		URL:   strings.TrimRight(site.BaseURL, "/") + "/list",
		Stage: "catalog",
		// Repeatable: true = 该任务会被「周期轮询」（到时重新抓取、发现新内容）。
		// 周期由 RepeatInterval 定（下面那行，只给这一条任务；不写 = 用本站 RepeatQueue 的 Interval）；
		// 两者都只在首次入库时播种，之后用后台任务表的「开/停轮询」「设轮询周期」改。
		// 不需要周期轮询就删掉这一行；整个站都不要就关站点声明里的 RepeatQueue / AutoRepeat。
		Repeatable: true,
		// RepeatInterval: 10 * time.Minute,
	}); err != nil {
		// SubmitTask 自带结构化日志；这里只补一句"入口没投进去"，然后就此打住。
		engine.GetLoggerSet().Engine.Errorf("submit initial task: %s", err.Error())
	}
}

func (f *FetchCatalog) FetchHandler(ctx context.Context, task *papa.Task, engine *papa.Engine) error {
	bw, err := engine.GetBrowserPool().Get(ctx)
	if err != nil {
		// 步骤追踪（crawler.trace.enabled 开启时生效）：失败时带上现场数据，后台「追踪」里能直接看到。
		// task.Trace 关闭时是 nil，这些调用都是安全的 no-op —— 不需要判空。
		task.Trace.Fail("取浏览器实例", err, nil)
		return err
	}
	defer engine.GetBrowserPool().Put(bw)

	page := bw.Browser.MustPage("")
	defer page.Close()

	if err := page.Context(ctx).Timeout(30 * time.Second).Navigate(task.URL); err != nil {
		task.Trace.Fail("打开列表页", err, map[string]string{"url": task.URL})
		return err
	}
	page.MustWaitLoad()
	// Step 表示「这一步已经做完了」，耗时按距上一步的间隔算
	task.Trace.Step("打开列表页", map[string]string{"url": task.URL})

	// TODO: 遍历列表项，提取标题和详情链接，然后派发子任务：
	// engine.SubmitTask(&papa.Task{PID: task.ID, URL: detailURL, Stage: "detail"})

	return nil
}
