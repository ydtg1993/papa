type FetchDetail struct{}

func (f *FetchDetail) GetStage() string { return "detail" } // 必须与 config.yaml 的 crawler.stages 的 key 一致

func (f *FetchDetail) FetchHandler(ctx context.Context, task *papa.Task, engine *papa.Engine) error {
	bw, err := engine.GetBrowserPool().Get(ctx)
	if err != nil {
		return err
	}
	defer engine.GetBrowserPool().Put(bw)

	page := bw.Browser.MustPage("")
	defer page.Close()

	if err := page.Context(ctx).Timeout(30 * time.Second).Navigate(task.URL); err != nil {
		return err
	}
	page.MustWaitLoad()

	// TODO: 提取字段，json.Marshal 后写回（content 结构见 models/content.go）：
	// engine.GetDB().Model(&papa.CrawlerTask{}).Where("id = ?", task.ID).
	//     Updates(map[string]any{"title": title, "content": datatypes.JSON(b)})

	return nil
}
