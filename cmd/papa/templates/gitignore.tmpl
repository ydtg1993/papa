# IDE
.idea/

# Claude Code 本地设置。
# **别整目录忽略** —— `.claude/skills/` 是随项目走的开发技能（papa new 生成），要进版本库；
# 所以只忽略 .claude 下的其余条目。
.claude/*
!.claude/skills/

# configs：只忽略 config.yaml（里面有 dsn 等本地值）；
# configs/config.yaml.example 是进版本库的范本，跟着项目走。站点声明在 sites/（顶层代码目录，不忽略）。
configs/config.yaml

# Logs 日志目录
logs/*
!logs/.gitkeep

# papa check 的临时校验目录（跑完自己会删；中断了会留下，别提交）
.papa-check/

# Go build artifacts
*.exe
*.exe~
*.test
*.out
bin/
dist/

# OS
.DS_Store
Thumbs.db

# downloads 资源下载目录
downloads/
