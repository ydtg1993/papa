package main

import (
	"context"
	"fmt"
	"os/signal"
	"syscall"

	"github.com/ydtg1993/papa/v2"
	"{{.Module}}/fetcher"
)

func main() {
	// 1. 创建应用容器（默认读 configs/config.yaml）
	//    自定义配置路径或注册模型：
	//    papa.New(papa.WithConfigPath("configs/config.yaml"), papa.WithModels(&models.YourModel{}))
	app, err := papa.New()
	if err != nil {
		panic(fmt.Sprintf("init app failed: %s", err.Error()))
	}

	// 2. 可选：设置中间件（代理 / m3u8 / 文件下载器），需在 RegisterStage 之前
	// app.Engine.SetProxy(proxy.NewManager(app.Config.Proxy.APIURL, 8*time.Minute))
	// app.Engine.SetM3U8(m3u8.NewDownloader(m3u8.DefaultConfig()))
	// app.Engine.SetFiledown(filedown.NewDownloader(filedown.DefaultConfig()))

	// 3. 注册爬虫阶段；回调里提交起始任务
	app.RegisterStage(&fetcher.FetchCatalog{},
		func(engine *papa.Engine) {
			if err := engine.SubmitTask(&papa.Task{
				PID:        0,
				URL:        app.Config.Crawler.Target, // 起始 URL，改成你的目标站
				Stage:      "catalog",
				Repeatable: true,
			}); err != nil {
				app.Logger.Engine.Errorf("submit initial task: %s", err.Error())
			}
		})

	// 4. 优雅关闭
	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	app.Run(ctx)
}
