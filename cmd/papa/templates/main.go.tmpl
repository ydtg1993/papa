package main

import (
	"context"
	"fmt"
	"os"
	"os/signal"
	"syscall"

	"github.com/ydtg1993/papa/v2"
	"{{.Module}}/fetcher"
)

func main() {
	// 1. 创建应用容器（默认读 configs/config.yaml）
	//    自定义配置路径或注册模型：
	//    papa.New(papa.WithConfigPath("configs/config.yaml"), papa.WithModels(&models.YourModel{}))
	app, err := papa.New()
	if err != nil {
		panic(fmt.Sprintf("init app failed: %s", err.Error()))
	}

	// 1.1 建表：`go run . -migrate`（Makefile 里是 `make migrate`）。
	//     框架自带的表（按配置开关）+ 你用 papa.WithModels 注册的模型一起建；
	//     AutoMigrate 只增不减、可重复跑，所以本地和上线前都可以随便跑。
	//     启动时**不会**自动迁移 —— 新开的开关（server.operation_log / crawler.trace.enabled）
	//     也要重跑一次才会建出对应的表。
	if len(os.Args) > 1 && os.Args[1] == "-migrate" {
		if err := app.Migrate(); err != nil {
			panic(fmt.Sprintf("migrate failed: %s", err.Error()))
		}
		fmt.Println("表已就绪。")
		return
	}

	// 2. 可选：设置中间件（代理 / m3u8 / 文件下载器），需在 RegisterStage 之前
	// app.Engine.SetProxy(proxy.NewManager(app.Config.Proxy.APIURL, 8*time.Minute))
	// app.Engine.SetM3U8(m3u8.NewDownloader(m3u8.DefaultConfig()))
	// app.Engine.SetFiledown(filedown.NewDownloader(filedown.DefaultConfig()))

	// 3. 注册爬虫阶段；回调里提交起始任务
	app.RegisterStage(&fetcher.FetchCatalog{},
		func(engine *papa.Engine) {
			if err := engine.SubmitTask(&papa.Task{
				PID:  0,
				URL:  app.Config.Crawler.Target, // 起始 URL，改成你的目标站
				Stage: "catalog",
				// Repeatable: true = 该任务会被「周期轮询」（定时重新抓取、发现新内容），
				// 由 configs/config.yaml 的 repeat_queue 驱动（enabled + interval）。
				// 不需要周期轮询就删掉这一行，或把 repeat_queue.enabled 设为 false。
				Repeatable: true,
			}); err != nil {
				app.Logger.Engine.Errorf("submit initial task: %s", err.Error())
			}
		})

	// 4. 可选：注册自己的后台表格页（声明式 —— 写 Go，不写前端）。
	//    内置的「任务」表（crawler_task）框架已自动注册，监控后台 /monitor 里直接能看；
	//    下面是再加一张自己的表。数据由你实现 oao.Source 提供：怎么过滤、怎么排序、
	//    查库还是调接口，全由你决定（组件只在中间做声明与转发）。
	//
	// app.UseTables(oao.Table{
	//     Key: "detail", Label: "详情", Group: "数据",
	//     Source: mySource, // 实现 List(ctx, oao.Query) (rows []map[string]any, total int64, err error)
	//     Columns: []oao.Column{
	//         {Field: "id", Kind: oao.KindNumber, Width: "70px", NoEdit: true},
	//         {Field: "url", Render: oao.RenderLink, Href: "{url}", NewTab: true},
	//         {Field: "status", Kind: oao.KindNumber, Render: oao.RenderEnum,
	//          Enum: map[string]string{"0": "待处理", "2": "成功"},
	//          Tone: map[string]string{"0": "info", "2": "ok"}},
	//     },
	//     Filters: []oao.Filter{
	//         {Field: "url", Op: oao.OpPrefix},  // 前缀匹配，能走索引；OpLike 是前后通配
	//         {Field: "status", Kind: oao.KindNumber, Op: oao.OpIn},
	//     },
	//     DefaultSort: "-id",
	// })
	//
	// 要写操作（编辑/删除/自定义）就给这张表声明 Actions，接法与示例见
	// docs/MONITOR.md 的「表格页（oao 组件）」。

	// 5. 优雅关闭
	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	app.Run(ctx)
}
