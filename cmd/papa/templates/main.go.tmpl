package main

import (
	"context"
	"fmt"
	"os"
	"os/signal"
	"syscall"

	"github.com/ydtg1993/papa/v2"
	"{{.Module}}/fetcher"
	"{{.Module}}/monitor"
)

func main() {
	// 1. 创建应用容器（默认读 configs/config.yaml）
	//    自定义配置路径：papa.New(papa.WithConfigPath("configs/config.yaml"))
	//    注册模型也可以走这里（papa.WithModels(...)），不过脚手架统一在 monitor/model 里登记。
	app, err := papa.New()
	if err != nil {
		panic(fmt.Sprintf("init app failed: %s", err.Error()))
	}

	// 1.1 后台接入：模型 / 表格页 / 自定义页 / 自定义路由与中间件都在 monitor 包里分层声明，
	//     这里一行接起。要加东西去改 monitor/ 下的对应层，别往 main 里堆。
	monitor.Register(app)

	// 1.2 建表：`go run . -migrate`（Makefile 里是 `make migrate`）。
	//     框架自带的表（按配置开关）+ monitor/model 里登记的模型一起建；
	//     AutoMigrate 只增不减、可重复跑，所以本地和上线前都可以随便跑。
	//     启动时**不会**自动迁移 —— 新开的开关（server.operation_log / crawler.trace.enabled）
	//     也要重跑一次才会建出对应的表。必须在 monitor.Register 之后：模型清单在那里登记。
	if len(os.Args) > 1 && os.Args[1] == "-migrate" {
		if err := app.Migrate(); err != nil {
			panic(fmt.Sprintf("migrate failed: %s", err.Error()))
		}
		fmt.Println("表已就绪。")
		return
	}

	// 2. 可选：设置中间件（代理 / m3u8 / 文件下载器），需在 RegisterStage 之前
	// app.Engine.SetProxy(proxy.NewManager(app.Config.Proxy.APIURL, 8*time.Minute))
	// app.Engine.SetM3U8(m3u8.NewDownloader(m3u8.DefaultConfig()))
	// app.Engine.SetFiledown(filedown.NewDownloader(filedown.DefaultConfig()))

	// 3. 注册爬虫阶段；回调里提交起始任务
	app.RegisterStage(&fetcher.FetchCatalog{},
		func(engine *papa.Engine) {
			if err := engine.SubmitTask(&papa.Task{
				PID: 0,
				// 起始 URL：改成你的目标站。任务里放什么都行（列表页、详情页、API 地址……），
				// 一个阶段也不限于一个站点 —— 多个站点/多种策略就多提交几条，
				// 或者在这里循环你自己的「分类 → 入口 URL」映射。
				URL:   "https://example.com/list",
				Stage: "catalog",
				// Repeatable: true = 该任务会被「周期轮询」（定时重新抓取、发现新内容），
				// 由 configs/config.yaml 的 repeat_queue 驱动（enabled + interval）。
				// 不需要周期轮询就删掉这一行，或把 repeat_queue.enabled 设为 false。
				Repeatable: true,
			}); err != nil {
				app.Logger.Engine.Errorf("submit initial task: %s", err.Error())
			}
		})

	// 4. 优雅关闭
	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	app.Run(ctx)
}
