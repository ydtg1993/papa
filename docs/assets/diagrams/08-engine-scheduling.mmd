flowchart TB
    DB[("MySQL pending<br/>持久积压")] --> R["每阶段独立投递器<br/>事件唤醒 + 到期定时器"]
    R --> A{"驻留容量与暂停检查"}
    A -->|暂不能投递| KEEP["保留持久 pending<br/>释放容量或恢复时继续"]
    A -->|允许| G["有界 keyset 查询<br/>版本化扫描游标"]
    G --> W["阶段有界 channel<br/>满队列阻塞，可取消"]
    W --> C["worker 准入与条件认领<br/>认领成功才执行"]
    C -->|释放容量| R
    C -->|终态或策略变化| DB
    D["唯一延迟堆<br/>每阶段最多一个在途处理"] -->|到期重验状态与代次| W
    STOP["暂停 / 关停"] -->|取消阻塞等待| KEEP
    API["启动 Entry 根 / SubmitChildren"] -->|阶段图与执行许可校验后持久化| DB
    classDef runtime fill:#e7f5ef,color:#174c3c,stroke:#449c7a;
    class DB,R,A,G,W,C,D,API runtime;
